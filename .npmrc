# The shared contract package is published to GitHub Packages under the
# @alkazat org scope. This maps that scope to the right registry so that, once
# @alkazat/contracts is added as a dependency, `npm ci` can resolve it. Auth (a
# read:packages token) is supplied at install time via NODE_AUTH_TOKEN
# (CI: the Actions GITHUB_TOKEN with packages:read; Vercel: a PAT env var) -
# never commit a token here.
#
# With no @alkazat/* dependency present yet, this file is inert, so the normal
# build stays green until the package is actually added.
@alkazat:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
