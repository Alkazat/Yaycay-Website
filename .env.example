# Back-end base URL (@alkazat/contracts). Supabase Edge Functions host, e.g.
# https://<project-ref>.supabase.co/functions/v1 . The /api/signup route proxies
# leads to POST {base}/signup-capture when this is set.
NEXT_PUBLIC_API_BASE=

# Project anon key, sent as the `apikey` header on BE calls (endpoints are public,
# no JWT). Server-side only in the proxy.
API_KEY=

# The app the visitor is handed to after capture (the free demo lives here).
NEXT_PUBLIC_APP_URL=https://app.yaycay.ai

# The public site origin, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://yaycay.ai

# Analytics / ad pixels. Lead event only fires after consent.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=

# Server-side Brevo capture fallback (used by /api/signup when NEXT_PUBLIC_API_BASE
# is not set, or when the BE call fails). Never exposed to the client.
BREVO_API_KEY=
# Optional: the Brevo list id new marketing contacts are added to.
BREVO_LIST_ID=
